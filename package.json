  },
  "keywords": [
    "claude-code",
    "wrapped",
    "year-in-review",
    "stats",
    "ai-agents",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openyard-cloud/agent-wrapped.git"
  },
  "homepage": "https://wrapped.openyard.cloud"
