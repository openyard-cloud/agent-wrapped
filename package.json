{
  "name": "agent-wrapped",
  "version": "0.1.0",
  "description": "Your year with Claude Code, Spotify Wrapped style. Made from the history on your computer; nothing is uploaded.",
  "type": "module",
  "bin": {
    "agent-wrapped": "bin/agent-wrapped.mjs"
  },
  "files": [
    "bin",
    "src",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
